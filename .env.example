# PostgreSQL connection used by the application and Drizzle Kit.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/recap_ai

# Required when storing API keys through the Settings page.
# Generate a strong value, for example: openssl rand -base64 32
APP_SECRET=replace-with-a-long-random-secret

# Optional: keys saved through Settings take priority over this value.
GEMINI_API_KEY=
